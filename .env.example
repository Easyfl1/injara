# Injara — Environment Variables
# Copy to .env and fill in values. Never commit secrets.

# ── Process ──────────────────────────────────────────────
PROCESS_ROLE=app          # app | worker
WORKER_SEND_ENABLED=false # true only on the single worker replica

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://injara:injara@localhost:5432/injara?schema=public

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling     # polling | webhook
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_TELEGRAM_IDS=     # comma-separated; empty = public
ADMIN_TELEGRAM_IDS=       # comma-separated
ADMIN_ALERT_CHAT_ID=      # chat id for admin alerts

# ── Admin Security ───────────────────────────────────────
ADMIN_TOTP_SECRET=
REQUIRE_ADMIN_2FA=false   # forced true on mainnet/live

# ── Flutterwave ──────────────────────────────────────────
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_ENV=sandbox           # sandbox | live

# ── CoinGecko ────────────────────────────────────────────
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_PLAN=demo       # demo | pro

# ── Injective ────────────────────────────────────────────
INJECTIVE_NETWORK=testnet  # testnet | mainnet
TREASURY_PRIVATE_KEY=
TREASURY_INJ_ADDRESS=

# ── Encryption ───────────────────────────────────────────
PII_ENCRYPTION_KEY=       # 32-byte hex (64 chars)
PII_BLIND_INDEX_KEY=      # 32-byte hex (64 chars)

# ── Business Logic ───────────────────────────────────────
BUY_FEE_BPS=200           # 2%
SELL_FEE_BPS=200          # 2%
QUOTE_TTL_SEC=180
PAYMENT_WINDOW_SEC=2700
PENDING_GRACE_SEC=1800
MAX_PAYMENT_WINDOW_EXTENSIONS=2
DEPOSIT_WINDOW_SEC=900
UNKNOWN_POLL_SEC=60
PRICE_MAX_AGE_SEC=120
CONFIRMATION_DEPTH=2
DAILY_USER_NGN_KOBO=10000000   # ₦100,000
MAX_PAYABLE_KOBO=10000000      # ₦100,000
LIFETIME_USER_NGN_KOBO=50000000 # ₦500,000
FLW_NGN_BALANCE_KOBO=          # ops override; unset = use API

# ── Feature Flags ────────────────────────────────────────
MAINTENANCE_MODE=false
BUY_ENABLED=true
SELL_ENABLED=true
DEPOSIT_MODE=memo          # memo | hd
