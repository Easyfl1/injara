{
  "name": "injara",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "PROCESS_ROLE=worker tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "PROCESS_ROLE=worker node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "check:denylist": "tsx scripts/check-sdk-denylist.ts"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/storage-redis": "^2.6.0",
    "@injectivelabs/networks": "^1.1.20",
    "@injectivelabs/sdk-ts": "1.20.34",
    "@prisma/client": "^6.1.0",
    "decimal.js": "^10.4.3",
    "fastify": "^5.2.0",
    "grammy": "^1.30.0",
    "ioredis": "^5.4.2",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
